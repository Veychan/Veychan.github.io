<section class="container collection-page"><header class="collection-header"><p class="section-kicker">THE TIMELINE / 时光切片</p><h1>把生长，写进时间里<span>。</span></h1><p>一共 <%= site.posts.length %> 篇记录。每一次落笔，都是一束微光。</p></header><div class="archive-list"><% let currentYear = ''; page.posts.sort('-date').each(post => { const year = date(post.date, 'YYYY'); if (year !== currentYear) { currentYear = year; %><h2 class="archive-year"><%= year %><span> / FIELD NOTES</span></h2><% } %><a class="archive-item" href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %></time><div><span class="category-label"><%= cg_category(post) %></span><h3><%= post.title %></h3><p><%= post.description %></p></div><%- cg_icon('arrow') %></a><% }); %></div><a class="text-link" href="<%= url_for('tags/') %>">按灵感标签探索 <%- cg_icon('right') %></a></section>
