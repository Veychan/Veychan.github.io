<!doctype html>
<html lang="zh-CN" data-theme="dark">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="dark light">
  <meta name="theme-color" content="#101110">
  <title><%= is_home() ? config.title + ' · ' + config.subtitle : (page.title || (is_archive() ? '时光归档' : '标签：' + page.tag)) + ' | ' + config.title %></title>
  <meta name="description" content="<%= page.description || config.description %>">
  <meta property="og:title" content="<%= page.title || config.title %>">
  <meta property="og:description" content="<%= page.description || config.description %>">
  <meta property="og:type" content="<%= is_post() ? 'article' : 'website' %>">
  <meta property="og:image" content="<%= full_url_for('images/golden-summit.webp') %>">
  <meta property="og:url" content="<%= full_url_for(page.path || '') %>">
  <link rel="canonical" href="<%= full_url_for(page.path || '') %>">
  <link rel="icon" href="<%= url_for('images/favicon.svg') %>" type="image/svg+xml">
  <link rel="alternate" type="application/atom+xml" title="朝光 RSS" href="<%= url_for('atom.xml') %>">
  <% if (is_home()) { %><link rel="preload" as="image" href="<%= url_for('images/golden-summit.webp') %>"><% } %>
  <script>try{document.documentElement.dataset.theme=localStorage.getItem('chaoguang-theme')==='light'?'light':'dark'}catch(e){}</script>
  <link rel="stylesheet" href="<%= url_for('css/style.css') %>">
</head>
<body class="<%= is_home() ? 'home-page' : is_post() ? 'post-page' : 'inner-page' %>">
  <a class="skip-link" href="#main">跳到正文</a>
  <div class="reading-progress" aria-hidden="true"></div>
  <%- partial('_partial/header') %>
  <main id="main"><%- body %></main>
  <%- partial('_partial/footer') %>
  <%- partial('_partial/search') %>
  <button class="back-top icon-button" aria-label="返回顶部"><%- cg_icon('up') %></button>
  <script id="site-config" type="application/json"><%- cg_json({root: url_for('/'), search: url_for('search.json'), walineModule: url_for('vendor/waline/waline.js'), walineStyle: url_for('vendor/waline/waline.css'), waline: config.waline || {}, path: page.path || ''}) %></script>
  <script src="<%= url_for('js/main.js') %>" defer></script>
</body>
</html>
