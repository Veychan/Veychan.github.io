<section class="container collection-page"><header class="collection-header"><p class="section-kicker">CONNECTED IDEAS / 灵感相连</p><h1><span>#</span> <%= page.tag %></h1><p>关于「<%= page.tag %>」的 <%= page.posts.length %> 篇记录。</p><a class="text-link" href="<%= url_for('tags/') %>">← 全部标签</a></header><div class="archive-list"><% page.posts.sort('-date').each(post => { %><a class="archive-item" href="<%= url_for(post.path) %>"><time datetime="<%= date_xml(post.date) %>"><%= date(post.date, 'MM.DD') %></time><div><span class="category-label"><%= cg_category(post) %></span><h3><%= post.title %></h3><p><%= post.description %></p></div><%- cg_icon('arrow') %></a><% }); %></div></section>
