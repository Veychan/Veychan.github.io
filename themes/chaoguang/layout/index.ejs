<section class="hero" aria-labelledby="hero-title">
  <div class="hero-image" role="img" aria-label="日出第一缕金光照亮连绵雪山"></div>
  <div class="hero-shade"></div><div class="hero-grid" aria-hidden="true"></div>
  <div class="container hero-content">
    <p class="eyebrow"><span class="status-dot"></span> HELLO, WORLD. <span class="eyebrow-line"></span> 你好，世界</p>
    <h1 id="hero-title"><%= theme.hero_title %><span><%= theme.hero_subtitle %><i class="typing-cursor"></i></span></h1>
    <p class="hero-motto"><span><%= theme.hero_motto %></span><strong><%= theme.hero_motto_prompt %></strong></p>
    <p class="hero-description"><%- theme.hero_description %></p>
    <div class="hero-actions"><a class="button button-primary" href="#writing">探索文章 <%- cg_icon('arrow') %></a><a class="button button-quiet" href="<%= url_for('about/') %>">认识朝光 <%- cg_icon('right') %></a></div>
    <div class="hero-caption"><span class="mono">SCROLL TO DISCOVER</span><span class="scroll-line"></span></div>
  </div>
  <div class="landscape-label"><span class="label-cross">+</span><div><span>日照金山 · 第一束光</span><small>THE FIRST LIGHT ON THE SUMMIT</small></div><span class="landscape-number">01 / ∞</span></div>
</section>
<div class="thought-strip"><div class="container"><span class="mono"><%- cg_icon('terminal') %> ~/chaoguang</span><span>保持好奇，持续构建。<em>Stay curious. Keep building.</em></span><span class="strip-status"><span class="status-dot"></span> ALWAYS GROWING</span></div></div>
<section class="container topics-overview" id="topics" aria-labelledby="topics-title">
  <div class="topics-heading"><p class="section-kicker">THREE DIRECTIONS / 三个方向</p><h2 id="topics-title">生活、探索，与思考<span>。</span></h2></div>
  <div class="topic-grid"><% theme.sections.forEach((section, index) => { const count = site.posts.filter(post => cg_category(post) === section.name).length; %>
    <a class="topic-card" href="<%= url_for(section.path) %>"><div class="topic-card-top"><span class="mono">0<%= index + 1 %> / <%= section.english %></span><%- cg_icon(section.icon) %></div><h3><%= section.name %></h3><p><%= section.description %></p><div class="topic-card-bottom"><span><%= count %> 篇记录</span><span>进入栏目 <%- cg_icon('arrow') %></span></div></a>
  <% }); %></div>
</section>
<div class="container home-layout" id="writing">
  <section class="writing-section" aria-labelledby="writing-title">
    <div class="section-top"><div><p class="section-kicker">THE LATEST / 最新记录</p><h2 id="writing-title">让灵感，在这里生根<span>。</span></h2></div><a class="text-link" href="<%= url_for('archives/') %>">全部归档 <%- cg_icon('arrow') %></a></div>
    <div class="filter-row" role="group" aria-label="按文章分类筛选"><button class="filter-button active" data-filter="all" aria-pressed="true">全部文章 <small><%= site.posts.length %></small></button><% theme.sections.forEach(section => { %><button class="filter-button" data-filter="<%= section.name %>" aria-pressed="false"><%= section.name %></button><% }); %><span class="filter-decoration">// IDEAS IN PROGRESS</span></div>
    <div class="post-grid">
    <% page.posts.each((post, index) => { %>
      <article class="post-card <%= index === 0 ? 'featured' : '' %>" data-category="<%= cg_category(post) %>">
        <a class="post-cover cover-<%= post.cover_style || 'sunrise' %>" href="<%= url_for(post.path) %>" tabindex="-1" aria-hidden="true">
          <% if (post.cover_style === 'summit') { %><div class="cover-mountain"></div><span class="cover-coordinates">LIGHT / CODE / LIFE</span><% } else if (post.cover_style === 'terminal') { %><div class="terminal-art"><span class="terminal-dots">● ● ●</span><code><span>~/chaoguang</span> $ git push<br><b>→</b> building your ideas…<br><b>✓</b> hello, world<span class="terminal-cursor">_</span></code></div><% } else if (post.cover_style === 'flower') { %><div class="cover-flower"><%- cg_flower() %></div><span class="cover-coordinates">GROW AT YOUR OWN PACE</span><% } else if (post.cover_style === 'code') { %><div class="code-art"><span>const</span> life = {<br>&nbsp; curiosity: <b>Infinity</b>,<br>&nbsp; direction: <em>'sunlight'</em><br>};<span class="code-bracket">{ }</span></div><% } else { %><div class="orbit-art"><span class="orbit-sun"></span><span class="orbit-circle c1"></span><span class="orbit-circle c2"></span><span class="orbit-circle c3"></span></div><span class="cover-coordinates">A LITTLE LIGHT GOES A LONG WAY</span><% } %>
          <span class="cover-index"><%= String(index + 1).padStart(2, '0') %> / FIELD NOTES</span><span class="cover-arrow"><%- cg_icon('arrow') %></span>
        </a>
        <div class="post-card-body"><div class="post-meta"><span class="category-label"><%= cg_category(post) %></span><% if (index === 0) { %><span class="featured-label">精选文章</span><% } %><time datetime="<%= date_xml(post.date) %>"><%= date(post.date) %></time></div><h3><a href="<%= url_for(post.path) %>"><%= post.title %></a></h3><p class="post-description"><%= post.description || strip_html(post.excerpt || post.content).slice(0, 90) %></p><div class="post-card-bottom"><div class="post-tags"><% post.tags.limit(2).each(tag => { %><a href="<%= url_for(tag.path) %>"># <%= tag.name %></a><% }); %></div><span class="reading-time"><%- cg_icon('clock') %><%= cg_reading(post.content) %> 分钟</span></div></div>
      </article>
    <% }); %>
    </div>
    <p class="filter-empty" hidden>这一页还没有这个分类的文章。去<a href="<%= url_for('archives/') %>">归档</a>看看吧。</p>
    <% if (page.total > 1) { %><nav class="pagination" aria-label="文章分页"><%- paginator({prev_text:'← 上一页', next_text:'下一页 →'}) %></nav><% } %>
    <div class="end-note"><span></span><%- cg_icon('sun') %><p>每一次记录，都是向光生长。</p><span></span></div>
  </section>
  <%- partial('_partial/sidebar') %>
</div>
